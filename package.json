{
  "name": "@scdh/seed-frontend-components",
  "private": false,
  "version": "0.5.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./redux": {
      "types": "./dist/redux/main.d.ts",
      "default": "./dist/redux/main.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --mode redux",
    "preview": "vite preview",
    "test": "vitest",
    "webjar": "./mkwebjar.sh",
    "doc": "typedoc",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@lit/context": "^1.1.1",
    "@reduxjs/toolkit": "^2.2.1",
    "@scdh/lit-redux-consumer": "^0.3.3",
    "@scdh/zero-ds": "^0.1.0",
    "anylogger": "^1.0.11",
    "deepmerge-ts": "^7.1.5",
    "jszip": "^3.10.1",
    "lit": "^3.1.3"
  },
  "devDependencies": {
    "anylogger-console": "^1.0.0",
    "prettier": "^3.5.3",
    "pretty-quick": "^4.1.1",
    "simple-git-hooks": "^2.12.1",
    "typedoc": "^0.28.2",
    "typescript": "^5.7.3",
    "typescript-plugin-css-modules": "^5.0.1",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-static-copy": "^2.2.0",
    "vitest": "^3.0.7"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "public/**/*",
    "vite.config.ts",
    "tsconfig.json"
  ]
}
